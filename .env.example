# Environment Variables for Cryptiq Bot
# Copy this file to .env and fill in your actual values
#
# Instructions:
# 1. Copy this file: cp .env.example .env (or copy .env.example .env on Windows)
# 2. Edit .env with your actual API keys
# 3. Never commit .env to version control

# ==========================================
# REQUIRED CONFIGURATION
# ==========================================

# Telegram Bot Token (required)
# Get this from @BotFather on Telegram: https://t.me/botfather
# After creating a new bot, BotFather will give you a token
TELEGRAM_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (required for AI-powered features)
# Get this from OpenAI Platform: https://platform.openai.com/account/api-keys
# You'll need to create an account and add billing information
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# OPTIONAL CONFIGURATION
# ==========================================

# Bot Admin User ID (optional - for admin-only commands)
# Your Telegram user ID - you can get it from @userinfobot
# ADMIN_USER_ID=123456789

# CoinGecko API Key (optional - for higher rate limits)
# Free tier works fine, but paid API key gives better limits
# Get from: https://www.coingecko.com/en/api
# COINGECKO_API_KEY=your_coingecko_api_key_here

# Default Language (optional - defaults to 'en')
# Supported: en, es, fr, de, it, pt, ru, zh, ja, ko
# DEFAULT_LANGUAGE=en

# Timezone (optional - defaults to UTC)
# Example: America/New_York, Europe/London, Asia/Tokyo
# TIMEZONE=UTC

# Log Level (optional - defaults to INFO)
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Database Path (optional - defaults to current directory)
# Where to store user data JSON files
# DATABASE_PATH=./data
